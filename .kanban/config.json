{
  "$comment": "Kanban settings for this repository, read by scripts/kanban.mjs. Tracked: no secrets, no machine paths. The notify target lives in .env.local.",
  "board": "macomprendo",
  "profilePrefix": "maco",
  "templates": "docs/agents/kanban",
  "rules": "AGENTS.md",
  "gate": "npm run test:swift",
  "gateOk": "suites passed after",
  "landChecks": [
    "npm run test:scripts",
    "npm run audit",
    "swift build --package-path macos",
    "npm run gen"
  ],
  "baseBranch": "main",
  "retries": {
    "impl": 2,
    "research": 1,
    "review": 1,
    "fix": 2
  },
  "maxRuntime": "2h",
  "skills": []
}
