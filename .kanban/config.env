# Kanban settings for this repository, read by the hermes-kanban-development
# scripts (https://github.com/DZamataev/hermes-tools, kanban/). Tracked; no
# secrets here, no machine-specific paths.

KANBAN_BOARD=macomprendo
# Role profiles: macoimpl, macoreview, macofix (see kanban-profiles.sh).
KANBAN_PROFILE_PREFIX=maco
# Where the role templates and per-card task files live.
KANBAN_TEMPLATES=docs/agents/kanban
# The repo's agent rules file, read first by every card.
KANBAN_RULES=AGENTS.md
# The gate every writing card runs, and the text its last line must contain.
KANBAN_GATE="npm run test:swift"
KANBAN_GATE_OK="suites passed after"
# Extra suites the orchestrator runs before landing a chain.
KANBAN_LAND_CHECKS="npm run test:scripts && npm run audit && swift build --package-path macos && npm run gen"
KANBAN_BASE_BRANCH=main
# Retries per role (circuit breaker: trips on the Nth failure).
KANBAN_RETRIES_IMPL=2
KANBAN_RETRIES_RESEARCH=1
KANBAN_RETRIES_REVIEW=1
KANBAN_RETRIES_FIX=2
# Per-card runtime cap: slices are small and the suite runs in seconds.
KANBAN_MAX_RUNTIME=2h
# Gitignored env of the primary checkout holding the notification target
# (KANBAN_NOTIFY_*); .env.example documents the shape.
KANBAN_NOTIFY_ENV=.env.local
