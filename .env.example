# Local operator configuration. Copy to .env.local and fill in.
# .env.local is gitignored; never commit real values.

# Where Kanban board notifications go (read by the hermes-kanban-development
# scripts through .kanban/config.env).
# A negative chat id is a group; the thread id selects a forum topic — leave it
# empty for a plain chat. See docs/hermes_kanban_development.md.
KANBAN_NOTIFY_CHAT_ID=
KANBAN_NOTIFY_THREAD_ID=
# Optional: another platform (default telegram) and the operator's user id
# (default: the chat id).
KANBAN_NOTIFY_PLATFORM=
KANBAN_NOTIFY_USER_ID=
