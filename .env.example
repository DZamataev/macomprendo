# Local operator configuration. Copy to .env.local and fill in.
# .env.local is gitignored; never commit real values.

# Where Kanban board notifications go. Format: <chat-id>[:<thread-id>].
# A negative chat id is a group; the thread id selects a forum topic.
# See docs/hermes_kanban_development.md.
KANBAN_NOTIFY_CHAT_ID=
KANBAN_NOTIFY_THREAD_ID=
